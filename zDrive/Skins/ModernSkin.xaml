<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Modern skin: crisp pixel-aligned text (Segoe UI, Display mode),
         integer border thickness and rounded high-contrast cards. -->

    <SolidColorBrush x:Key="IconBrush" Color="#FF6FB2FF" />
    <SolidColorBrush x:Key="IconBrushSelected" Color="#FF4A9EFF" />
    <SolidColorBrush x:Key="ColorMaskGray2" Color="#FF414B5A" />
    <SolidColorBrush x:Key="ColorMaskGray3" Color="#E61B2028" />

    <SolidColorBrush x:Key="Stroke" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="Foreground" Color="#FFE9EDF3" />
    <SolidColorBrush x:Key="ForegroundName" Color="#FFF5F7FA" />
    <SolidColorBrush x:Key="ForegroundInfo" Color="#FFB9C2CF" />

    <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="#FF3A4350" />
    <SolidColorBrush x:Key="SpaceEnough" Color="#FF4A9EFF" />
    <SolidColorBrush x:Key="SpaceNotEnough" Color="#FFFF7043" />

    <SolidColorBrush x:Key="SettingsFillBrush" Color="#FF4A9EFF" />

    <LinearGradientBrush x:Key="SpaceEnoughGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3D7BFF" Offset="0" />
        <GradientStop Color="#FF6FBDFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SpaceNotEnoughGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF6A3D" Offset="0" />
        <GradientStop Color="#FFFFA26B" Offset="1" />
    </LinearGradientBrush>

    <system:Double x:Key="MenuFontSize">12</system:Double>

    <FontFamily x:Key="ContentFontFamily">Segoe UI</FontFamily>
    <FontWeight x:Key="ContentFontWeight">SemiBold</FontWeight>
    <FontStretch x:Key="ContentFontStretch">Normal</FontStretch>
    <system:Double x:Key="ContentFontSize">13</system:Double>

    <FontFamily x:Key="ContentFontFamilyL2">Segoe UI</FontFamily>
    <FontWeight x:Key="ContentFontWeightL2">Normal</FontWeight>
    <FontStretch x:Key="ContentFontStretchL2">Normal</FontStretch>
    <system:Double x:Key="ContentFontSizeL2">11</system:Double>

    <Style TargetType="TextBlock" x:Key="TextBlockL1">
        <Setter Property="FontFamily" Value="{StaticResource ContentFontFamily}" />
        <Setter Property="FontWeight" Value="{StaticResource ContentFontWeight}" />
        <Setter Property="FontStretch" Value="{StaticResource ContentFontStretch}" />
        <Setter Property="FontSize" Value="{StaticResource ContentFontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="TextBlock" x:Key="TextBlockL2">
        <Setter Property="FontFamily" Value="{StaticResource ContentFontFamilyL2}" />
        <Setter Property="FontWeight" Value="{StaticResource ContentFontWeightL2}" />
        <Setter Property="FontStretch" Value="{StaticResource ContentFontStretchL2}" />
        <Setter Property="FontSize" Value="{StaticResource ContentFontSizeL2}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <ControlTemplate x:Key="PropertiesBackground">
        <Grid>
            <Border Background="{StaticResource ColorMaskGray3}" BorderBrush="{StaticResource ColorMaskGray2}"
                    BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ItemsBackground">
        <Grid HorizontalAlignment="Stretch">
            <Border Background="{StaticResource ColorMaskGray3}" BorderBrush="{StaticResource ColorMaskGray2}"
                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True" />
        </Grid>
    </ControlTemplate>

    <Thickness x:Key="ItemsMargin">1</Thickness>
    <Thickness x:Key="ItemContentMargin">6,4</Thickness>

    <GridLength x:Key="IconColumnWidth">36</GridLength>
    <system:Double x:Key="IconImageSize">24</system:Double>
    <system:Double x:Key="DefaultHeight">48</system:Double>
    <system:Double x:Key="DefaultWidth">168</system:Double>
    <system:Double x:Key="DefaultProgressBarHeight">8</system:Double>

    <Style TargetType="ProgressBar" x:Key="ProgressBarStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="{StaticResource ProgressBarBorderBrush}"
                            Background="#1FFFFFFF"
                            BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True" Margin="0" Padding="1">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SpaceEnoughGradient}" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Path=Value, Converter={StaticResource PercentToBoolConverter}}"
                                                Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource SpaceNotEnoughGradient}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
